# ---------------------------------------------------------------------------
# Plantilla de configuracion del Sistema de Matricula.
#
#   cp .env.example .env
#
# Este archivo SI se comitea; el .env resultante NO (esta en .gitignore).
# Todos los valores de aqui son de ejemplo y deliberadamente falsos: nunca se
# escribe una credencial real en este archivo.
#
# En DEV, STAGING y PROD la aplicacion no usa .env: Elastic Beanstalk inyecta
# estas mismas variables desde AWS Secrets Manager (CI_CD.md seccion 7). La
# imagen es identica en todos los ambientes; lo unico que cambia es esta
# configuracion.
# ---------------------------------------------------------------------------


# --- Base de datos (PostgreSQL 16) -----------------------------------------
# Formato: postgresql+psycopg://<usuario>:<password>@<host>:<puerto>/<base>
# El host es "postgres" (nombre del servicio en docker-compose), no "localhost".
DATABASE_URL=postgresql+psycopg://matricula:CHANGE_ME@postgres:5432/matricula

# Credenciales con las que docker-compose inicializa el contenedor de Postgres.
# Deben ser coherentes con DATABASE_URL.
POSTGRES_USER=matricula
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=matricula


# --- Cache (Redis 7) --------------------------------------------------------
# El host es "redis" (nombre del servicio en docker-compose).
REDIS_URL=redis://redis:6379/0

# Vigencia de las entradas de cache del catalogo, en segundos. Corto a proposito: el
# catalogo apenas cambia durante el semestre, pero un TTL largo retrasaria la visibilidad
# de un grupo recien abierto. La disponibilidad de cupos NO se cachea nunca, asi que este
# valor no afecta a su exactitud.
CATALOG_CACHE_TTL_SECONDS=30


# --- Autenticacion ----------------------------------------------------------
# JWT_SECRET se GENERA POR AMBIENTE y nunca se reutiliza entre dev, staging y
# prod, ni se comitea. Generalo con:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# En AWS vive en Secrets Manager bajo el nombre JWT_SECRET_KEY.
JWT_SECRET=

# Vigencia del access token, en segundos (1 hora).
JWT_EXPIRATION_SECONDS=3600
# Vigencia del refresh token, en segundos (7 dias).
JWT_REFRESH_EXPIRATION_SECONDS=604800


# --- Aplicacion -------------------------------------------------------------
# Ambiente logico: dev | staging | prod
ENVIRONMENT=dev
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Prefijo de la version 1 de la API.
API_V1_PREFIX=/api/v1
# Version de la aplicacion que reporta /health.
APP_VERSION=0.1.0

# Origenes del navegador autorizados a llamar a la API, separados por comas.
# En local es el servidor de desarrollo de Vite. En la nube es el dominio de
# CloudFront (o el de Amplify): el frontend se sirve desde un dominio DISTINTO
# del de la API, y sin esta lista el navegador bloquea todas las llamadas.
# Nunca se pone "*": la API acepta credenciales y el comodin ni siquiera es
# valido en ese caso.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Publicar o no /docs, /redoc y /openapi.json. Conviene apagarlo en produccion:
# exponen el mapa completo de la API, incluidos los endpoints de administracion.
DOCS_ENABLED=true


# --- Pool de conexiones a PostgreSQL ----------------------------------------
# Conexiones por PROCESO. El limite real lo pone RDS: su max_connections se
# reparte entre todas las instancias que levante el autoescalado. Con 10+20,
# cuatro instancias agotan una db.t3.micro (~87 conexiones). Si el autoescalado
# va a subir de ahi, hay que bajar estos valores o subir de instancia.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# --- Puertos publicados en la maquina local (opcional) ----------------------
# Solo afectan a docker-compose. Cambialos si esos puertos ya estan ocupados.
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
