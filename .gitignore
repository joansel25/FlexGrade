# ---------------------------------------------------------------------------
# Secretos y configuracion local  (lo mas importante de este archivo)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# El .env de los tests del frontend SI se comitea: no lleva secretos y el runner del CI
# no tiene ningun .env.local, asi que sin el los tests apuntarian a una URL vacia.
!frontend/.env.test
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
.azure/

