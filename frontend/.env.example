# ---------------------------------------------------------------------------
# Configuracion del frontend.
#
#   cp .env.example .env.local
#
# Vite solo expone al navegador las variables que empiezan por VITE_. Esa regla
# es una proteccion, no una molestia: cualquier valor que pongas aqui acaba
# dentro del bundle y es publico. NUNCA se pone un secreto en este archivo.
# ---------------------------------------------------------------------------

# URL base de la API. En local es el backend de docker-compose; en la nube es el
# dominio publico de la API (Application Gateway), y se fija en tiempo de BUILD,
# porque el frontend compilado son archivos estaticos en Azure Storage servidos
# por Azure Front Door.
VITE_API_BASE_URL=http://localhost:8000
