# Configuracion que usan los tests (Vite carga este archivo cuando el modo es `test`).
#
# SI se comitea, y a proposito: los tests tienen que dar el mismo resultado en la maquina de
# quien desarrolla y en el runner del CI, que no tiene ningun `.env.local`. El valor coincide
# con el que interceptan los handlers de MSW en `src/test/msw/handlers.ts`; si los dos dejan de
# coincidir, ninguna peticion queda interceptada y todos los tests fallan a la vez.
VITE_API_BASE_URL=http://localhost:8000
